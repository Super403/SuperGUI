/* ══════════  深色主题  ══════════ */

QMainWindow, QDialog, QMessageBox, QInputDialog { background: #1e2126; }
QWidget { font-family: "Microsoft YaHei UI", "Segoe UI Variable Text", "Microsoft YaHei"; color: #e6e9ee; font-size: 13px; }
QLabel { background: transparent; }
QToolTip { background: #3a3f47; color: #fff; border: none; padding: 5px 9px; border-radius: 6px; }

/* ── 顶栏 ── */
#TopBar { background: #26292f; border-bottom: 1px solid #343941; }
#Brand { font-size: 15px; font-weight: 700; }
#BrandSub { color: #7d8791; font-size: 11px; padding-top: 3px; }
#WorkspaceBtn {
    background: #1e2126; border: none; border-radius: 8px;
    padding: 6px 11px; color: #9aa3af; font-size: 12px; text-align: left;
}
#WorkspaceBtn:hover { color: #5fd08e; background: rgba(60, 181, 111, 0.16); }
#WorkspaceBtn[active="true"] { color: #5fd08e; background: rgba(60, 181, 111, 0.16); font-weight: 600; }
#SearchBar {
    background: #1e2126; border: 2px solid transparent; border-radius: 19px;
    padding: 7px 14px; font-size: 13px; color: #e6e9ee; selection-background-color: #2f5d43;
}
#SearchBar:focus { border-color: #3cb56f; background: #26292f; }
#TopIconBtn { background: transparent; border: none; border-radius: 8px; }
#TopIconBtn:hover { background: rgba(60, 181, 111, 0.16); }
#TopIconBtn:checked { background: rgba(60, 181, 111, 0.16); }

/* ── 侧边栏 ── */
#SideBar { background: #26292f; border-right: 1px solid #343941; }
#NavTitle { color: #6b7480; font-size: 11px; letter-spacing: 1px; padding: 0 12px; }
#NavButton {
    background: transparent; border: none; border-radius: 8px;
    padding: 8px 10px; color: #9aa3af; font-size: 13px; text-align: left;
}
#NavButton:hover { background: rgba(60, 181, 111, 0.16); color: #5fd08e; }
#NavButton:checked { background: rgba(60, 181, 111, 0.16); color: #5fd08e; font-weight: 700; }
#TagBtn {
    background: #1e2126; border: 1px solid transparent; border-radius: 11px;
    padding: 3px 10px; font-size: 11px; color: #9aa3af;
}
#TagBtn:hover { background: rgba(60, 181, 111, 0.16); color: #5fd08e; }
#TagBtn:checked { background: rgba(60, 181, 111, 0.16); color: #5fd08e; border-color: #3cb56f; font-weight: 600; }
#UsageCard { background: #1e2126; border-radius: 10px; }
#UsageNum { font-weight: 700; color: #5fd08e; }
#UsageBar { background: #343941; border: none; border-radius: 2px; }
#UsageBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #46c77c, stop:1 #2f9d5d); border-radius: 2px; }
#SideScroll { background: #26292f; border: none; }
#SideScroll > QWidget { background: transparent; }
#SideContent { background: transparent; }

/* ── 内容区 ── */
#Content { background: #1e2126; }
#ContentTitle { font-size: 18px; font-weight: 700; color: #e6e9ee; padding-left: 9px; border-left: 4px solid #3cb56f; }
#ContentSub { color: #6b7480; font-size: 12px; padding-left: 8px; }
#CardScroll, #CardContainer { background: transparent; border: none; }
#CatHead { color: #9aa3af; font-size: 13px; font-weight: 700; padding-bottom: 2px; border-bottom: 1px solid #343941; }
#EmptyTip { color: #6b7480; font-size: 13px; padding: 60px; }

/* 统计卡片 */
#StatCard { background: #2b2f36; border: 1px solid #343941; border-radius: 10px; }
#StatKey { color: #9aa3af; font-size: 12px; }
#StatValue { font-size: 24px; font-weight: 800; }

/* ── 条目卡片 ── */
#EntryCard { background: #2b2f36; border: 2px solid #3a3f47; border-radius: 10px; }
#EntryCard:hover { border-color: #3cb56f; }
#EntryCard[selected="true"] { border-color: #3cb56f; background: rgba(60, 181, 111, 0.10); }
#CardName { font-weight: 700; font-size: 13px; }
#CardDesc { color: #6b7480; font-size: 11px; }
#CardStar { color: #f7b73c; font-size: 13px; }

/* ── 详情面板 ── */
#DetailPanel { background: #26292f; border-left: 1px solid #343941; }
#DetailEmpty { color: #6b7480; font-size: 13px; }
#DetailTitle { color: #6b7480; font-size: 12px; font-weight: 700; letter-spacing: 1px; }
#DetailName { font-size: 16px; font-weight: 700; }
#DetailPath { color: #6b7480; font-size: 11px; }
#DetailTags { color: #5fd08e; font-size: 12px; }
#DetailSection { color: #6b7480; font-size: 11px; letter-spacing: 1px; }

#PrimaryBtn {
    background: #3cb56f; color: #ffffff; border: none; border-radius: 8px;
    padding: 8px 16px; font-weight: 700; font-size: 13px;
}
#PrimaryBtn:hover { background: #4cc780; }
#PrimaryBtn:pressed { background: #2f9d5d; }
#GhostBtn {
    background: #2b2f36; border: 1px solid #3a3f47; border-radius: 8px;
    padding: 8px 12px; font-weight: 600; color: #e6e9ee;
}
#GhostBtn:hover { border-color: #3cb56f; color: #5fd08e; }
#MiniBtn {
    background: transparent; border: 1px solid #3a3f47; border-radius: 6px;
    padding: 3px 10px; font-size: 11px; color: #9aa3af;
}
#MiniBtn:hover { border-color: #3cb56f; color: #5fd08e; }

#CmdBox {
    background: #1e2126; border: 1px solid #343941; border-radius: 8px;
    color: #5fd08e; font-family: "Cascadia Code", Consolas, monospace;
    font-size: 12px; padding: 9px 11px;
}
#NoteView, #NoteEdit {
    background: #1e2126; border: 1px solid #343941; border-radius: 8px;
    font-size: 12px; padding: 8px; color: #e6e9ee; selection-background-color: #2f5d43;
}
#NoteEdit { font-family: "Cascadia Code", Consolas, monospace; }
#StatMini { background: #1e2126; border: 1px solid #343941; border-radius: 8px; }
#StatMiniValue { font-size: 15px; font-weight: 800; color: #5fd08e; }
#StatMiniKey { font-size: 11px; color: #6b7480; }

/* ── 状态栏 ── */
#StatusBar { background: #26292f; border-top: 1px solid #343941; }
#StatusOk { color: #5fd08e; font-weight: 600; font-size: 11px; }
#StatusText { color: #6b7480; font-size: 11px; }

/* ── 菜单 ── */
QMenu {
    background: #2b2f36; border: 1px solid #3a3f47; border-radius: 10px; padding: 5px;
}
QMenu::item { padding: 7px 22px 7px 12px; border-radius: 7px; color: #e6e9ee; }
QMenu::item:selected { background: rgba(60, 181, 111, 0.16); color: #5fd08e; }
QMenu::separator { height: 1px; background: #343941; margin: 5px 8px; }

/* ── 滚动条 ── */
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: #454b54; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #596069; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 2px; }
QScrollBar::handle:horizontal { background: #454b54; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #596069; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ── 对话框控件 ── */
QLineEdit, QComboBox {
    background: #1e2126; border: 1px solid #3a3f47; border-radius: 7px; padding: 6px 10px; color: #e6e9ee;
}
QLineEdit:focus, QComboBox:focus { border-color: #3cb56f; }
QComboBox::drop-down { border: none; width: 24px; }
QDialogButtonBox QPushButton {
    background: #3cb56f; color: #fff; border: none; border-radius: 7px; padding: 7px 18px; min-width: 64px;
}
QDialogButtonBox QPushButton:hover { background: #4cc780; }

/* ── 设置对话框 ── */
#SettingsSection { color: #6b7480; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
#SettingsCard { background: #2b2f36; border: 1px solid #343941; border-radius: 10px; }
#SettingsKey { color: #9aa3af; }
#SettingsValue { color: #6b7480; font-size: 12px; }
#SettingsHint { color: #6b7480; font-size: 11px; }
#SettingsHint[invalid="true"] { color: #f0524f; }
QLineEdit[invalid="true"] { border-color: #f0524f; }

/* ── macOS 风格标题栏 ── */
#TitleBar { background: #26292f; border-bottom: 1px solid #343941; }
#TitleText { color: #7d8791; font-size: 12px; font-weight: 600; }
#MacBtn { border: none; border-radius: 7px; color: transparent; font-size: 9px; font-weight: 700; padding: 0; }
#MacBtn[kind="close"] { background: #ff5f57; }
#MacBtn[kind="min"] { background: #febc2e; }
#MacBtn[kind="max"] { background: #28c840; }
#MacBtn:hover { color: rgba(0, 0, 0, 110); }

/* ── Windows 风格标题栏按钮（— □ ✕ 右侧，悬停变灰，关闭悬停变红） ── */
#WinBtn { border: none; background: transparent; color: #9aa3af; font-size: 13px; padding: 0 0 2px 0; }
#WinBtn:hover { background: #343941; }
#WinBtn[kind="close"]:hover { background: #e81123; color: #ffffff; }
